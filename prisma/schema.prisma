generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum GroupMemberStatus {
  REQUESTED
  APPROVED
  JOINED
  ATTENDED
  NO_SHOW
  REJECTED
}

enum EventStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum GroupStatus {
  OPEN
  FULL
  CLOSED
  COMPLETED
}

enum NotificationType {
  GROUP_APPROVED
  EVENT_CREATED
  EVENT_REMINDER
  ATTENDANCE_MARKED
  FRIEND_INVITE
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
}

enum AttendanceStatus {
  ATTENDED
  NO_SHOW
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  name         String
  role         Role             @default(USER)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  preference   UserPreference?
  memberships  GroupMember[]
  feedback     Feedback[]
  devices      UserDevice[]
  notifications Notification[]
  passwordResets PasswordResetToken[]
  emailLogs    EmailLog[]
  comments     EventComment[]
  reportsMade  SafetyReport[] @relation("reportsMade")
  reportsReceived SafetyReport[] @relation("reportsReceived")
  blocksMade   UserBlock[] @relation("blocksMade")
  blockedBy    UserBlock[] @relation("blockedBy")
  attendance   EventAttendance[]
  inviteLinks  InviteLink[]

  @@index([role])
}

model UserPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  ageRange           String
  city               String
  neighborhood       String
  goals              String[]
  activities         String[]
  currentLevel       String
  targetGoal         String
  availability       String[]
  preferredGroupSize Int
  vibe               String
  comfortPreference  String
  photoUrl           String?
  phone              String?
  bio                String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city, neighborhood])
  @@index([currentLevel])
}

model Goal {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  groups    Group[]
}

model Activity {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  groups    Group[]
}

model Group {
  id           String        @id @default(cuid())
  title        String
  goalId       String
  activityId   String
  city         String
  neighborhood String
  level        String
  ageRange     String
  vibe         String
  maxMembers   Int
  schedule     String
  description  String
  status       GroupStatus   @default(OPEN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  goal         Goal          @relation(fields: [goalId], references: [id])
  activity     Activity      @relation(fields: [activityId], references: [id])
  members      GroupMember[]
  events       Event[]
  inviteLinks  InviteLink[]

  @@index([city, neighborhood, status])
  @@index([level, vibe])
}

model GroupMember {
  id        String            @id @default(cuid())
  userId    String
  groupId   String
  status    GroupMemberStatus @default(REQUESTED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId, status])
}

model Event {
  id           String      @id @default(cuid())
  groupId      String
  title        String
  locationName String
  address      String
  startTime    DateTime
  endTime      DateTime
  description  String
  hostName     String
  status       EventStatus @default(UPCOMING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  group        Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  feedback     Feedback[]
  comments     EventComment[]
  attendance   EventAttendance[]

  @@index([groupId, startTime])
  @@index([status, startTime])
}

model Feedback {
  id                String   @id @default(cuid())
  userId            String
  eventId           String
  rating            Int
  comfortScore      Int
  groupMatchScore   Int
  wouldAttendAgain  Boolean
  comment           String?
  wouldInviteFriend Boolean
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
}

model UserDevice {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([type])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  userId    String?
  to        String
  subject   String
  body      String
  status    String   @default("QUEUED")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
}

model EventComment {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  body      String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([userId])
}

model SafetyReport {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String?
  groupId        String?
  eventId        String?
  reason         String
  details        String?
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reporter       User         @relation("reportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User?        @relation("reportsReceived", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([reportedUserId])
}

model UserBlock {
  id            String   @id @default(cuid())
  blockerId     String
  blockedUserId String
  createdAt     DateTime @default(now())
  blocker       User     @relation("blocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser   User     @relation("blockedBy", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@index([blockedUserId])
}

model EventAttendance {
  id        String           @id @default(cuid())
  eventId   String
  userId    String
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
}

model InviteLink {
  id        String    @id @default(cuid())
  groupId   String
  createdById String
  token     String    @unique
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([createdById])
}
