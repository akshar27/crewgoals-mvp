{
  "expo": {
    "name": "CrewGoals",
    "slug": "crewgoals",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "crewgoals",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crewgoals.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.crewgoals.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#dff4e9"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#426653"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:3000",
      "eas": {
        "projectId": "4aa154ca-4b9e-4c6b-abb0-313db53ff6d9"
      }
    }
  }
}
